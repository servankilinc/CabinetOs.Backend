{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Database": "Server=localhost;Database=CabinetOs;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Cors": {
    "Origins": [
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  },
  "TokenSettings": {
    "Audience": "CabinetOs.com",
    "Issuer": "CabinetOs.com",
    "AccessTokenExpiration": 1440,
    "RefreshTokenExpiration": 10080,
    "SecurityKey": "ugFHF1+AqbEVS/yZCH1TyEec4UbKg53eGn4FNcaDsqgOevhH4uZ+9yivTiHg7XbecrSxwaohIFKhj0NG6bJGjA==",
    "RefreshTokenTTL": 7
  },
  "CacheSettings": {
    "SlidingExpirationMinutes": 30,
    "AbsoluteExpirationMinutes": 120
  },
  "Scada": {
    // Bu kadar saniyedir haber alinamayan cihaz Offline'a cekilir. SCADA'nin
    // gonderim periyodundan BELIRGIN sekilde buyuk olmali; aksi halde tek bir
    // gecikmis paket cihazi Offline/Online arasinda sallandirir.
    "StaleAfterSeconds": 120,
    "SweepIntervalSeconds": 60,
    // Ingest ucunun 10 saniyelik butcesi. SCADA tek IP'den geldigi icin butun
    // kabinlerin trafigi bu tek butceyi paylasir — kabin sayisiyla olceklendirin.
    "RateLimitPermitsPer10Seconds": 600
  },
  "LocalizationSettings": {
    "DefaultLanguage": "tr-TR",
    "AvailableLanguages": [
      "tr-TR",
      "en-US"
    ]
  },
  "AllowedHosts": "*"
}
